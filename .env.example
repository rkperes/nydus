# Copy to `.env` and edit. `.env` is gitignored; this file is the template.
# Values use KEY=value with no spaces and no quotes — the Makefile includes this
# file directly, so it must stay make-compatible.

# SSH alias (or user@host) the workstation uses to reach the server.
SERVER=pc

# Address baked into the API server's TLS SANs. Leave unset to have
# `make cluster-up` infer it: the server's tailnet IP if tailscale is present,
# else its primary IP. Set it only when the inference is wrong (e.g. a
# non-tailscale server whose primary IP is not the one kubectl should dial).
#API_SERVER_ADDRESS=

# Where the fetched kubeconfig lands. Defaults to ~/.kube/nydus-lab.yaml.
#KUBECONFIG_FILE=/Users/you/.kube/nydus-lab.yaml
